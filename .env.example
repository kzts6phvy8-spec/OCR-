# Anthropic API キー (必須)
ANTHROPIC_API_KEY=sk-ant-...

# 解析に使うモデル (既定: claude-sonnet-5-5)
# claude-3-5-sonnet / claude-3-7-sonnet は提供終了済みのため使用できません
CLAUDE_MODEL=claude-sonnet-5-5

# 解析の思考量: low / medium / high (既定: low = 高速。読み取りが不安定なら medium)
CLAUDE_EFFORT=low

# API タイムアウト (ミリ秒) と SDK のリトライ回数
CLAUDE_TIMEOUT_MS=45000
CLAUDE_MAX_RETRIES=2

# API サーバーのポートとデータ保存先
PORT=3001
DATA_DIR=./data
