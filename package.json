  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
